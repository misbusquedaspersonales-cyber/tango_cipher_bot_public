# Local clone of the private repo (cipher_engine.py + tangos.json).
# Populated by scripts/dev/setup_private_core.sh — NEVER committed.
# This is the whole point of the split: if this line is ever removed
# or this folder ever gets force-added, the secret corpus goes public.
private_core/

# Python
__pycache__/
*.pyc
venv/
.env

# APK build — keystore and password must NEVER be committed
tango-cifrado-apk/android.keystore
tango-cifrado-apk/keystore-password.txt
# Build logs and intermediate Gradle/SDK artifacts
_build_apk_logs/
tango-cifrado-apk/app/
tango-cifrado-apk/.gradle/
tango-cifrado-apk/android/
dist/apk/
# Generated by bubblewrap build — not source, regenerated on each build
tango-cifrado-apk/build.gradle
tango-cifrado-apk/gradle.properties
tango-cifrado-apk/settings.gradle
tango-cifrado-apk/gradlew
tango-cifrado-apk/gradlew.bat
tango-cifrado-apk/gradle/
tango-cifrado-apk/store_icon.png
tango-cifrado-apk/manifest-checksum.txt
tango-cifrado-apk/*.idsig
tango-cifrado-apk/*.apk
tango-cifrado-apk/*.aab
tango-cifrado-apk/twa-manifest.json.bak
# twa-config.json is generated by bubblewrap init — twa-manifest.json is the source of truth
tango-cifrado-apk/twa-config.json
# strings.xml and colors.xml are stub templates; bubblewrap regenerates the real
# values (hostName, launchUrl, colorPrimary, etc.) from twa-manifest.json at build
# time into app/build/. The committed files are intentionally incomplete placeholders.
# See TO_FIX.md M-2 for CI implications.
tango-cifrado-apk/app/src/main/res/values/strings.xml
tango-cifrado-apk/app/src/main/res/values/colors.xml

# OS cruft
.DS_Store
