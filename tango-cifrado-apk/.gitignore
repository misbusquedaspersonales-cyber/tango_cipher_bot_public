# ============================================================
# NUNCA commitear la keystore ni sus contraseñas.
# Si esto va a un repo público, perder la identidad de firma
# es el peor caso: nadie puede publicar updates con el mismo
# package name sin re-empaquetar como app nueva.
# ============================================================
*.keystore
*.jks
# Belt-and-suspenders: explicit names in case the glob above is bypassed
android.keystore
keystore-password.txt
signing.gradle.properties
keystore.properties
local.properties

# Sandbox artifacts — generated by _runall_sandbox.sh (compromised password)
assetlinks.generated.json
SANDBOX_KEYSTORE_DO_NOT_SHIP.txt

# ============================================================
# Bubblewrap / Gradle build artifacts
# ============================================================
.gradle/
build/
*/build/
captures/
.externalNativeBuild/
.cxx/
app/release/
app/debug/

# APK / AAB finales (se pueden subir a GitHub Releases, no al repo)
*.apk
*.aab
*.apks

# Bubblewrap runtime files
twa-manifest.json.bak
.bubblewrap/

# Android Studio / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# OS noise
.DS_Store
Thumbs.db
