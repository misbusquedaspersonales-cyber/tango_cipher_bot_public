TELEGRAM_BOT_TOKEN=TU_BOT_TOKEN_AQUI
TELEGRAM_CHAT_ID=TU_CHAT_ID_AQUI

# Repositories
PUBLIC_REPO_NAME=nombre_del_repo_publico
PRIVATE_REPO_NAME=nombre_del_repo_privado
GITHUB_TOKEN=tu_github_personal_access_token

# Secret Keys
CLAVE_DESPLIEGUE=tu_clave_secreta_de_despliegue_aqui
CIFRADO_SALT=tu_salt_numerico_aqui

# Deploy — these mirror the GitHub Actions secrets of the same name.
# PUBLIC_REPO_DEPLOY_TOKEN: set in the PRIVATE repo's Settings → Secrets;
#   used by build-encrypted-bundle.yml's deploy-to-public-repo job to push
#   pwa/encrypted-bundle.json to the public repo.
PUBLIC_REPO_DEPLOY_TOKEN=tu_github_pat_para_deploy_aqui

# PRIVATE_REPO_PAT: set in the PUBLIC repo's Settings → Secrets; used by
#   drift-check.yml to read the private repo's HEAD SHA. Required or that
#   workflow fails every run.
PRIVATE_REPO_PAT=tu_github_pat_de_solo_lectura_al_repo_privado_aqui
